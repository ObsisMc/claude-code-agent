{
  "name": "@ora-space/claude-agent",
  "version": "0.4.4",
  "exports": "./src/main.ts",
  "minimumDependencyAge": 0,
  "imports": {
    "@ora-space/plugin-sdk": "jsr:@ora-space/plugin-sdk@0.11.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/crypto": "jsr:@std/crypto@^1.0.5",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/tar": "jsr:@std/tar@^0.1.10",
    "@zip-js/zip-js": "jsr:@zip-js/zip-js@^2.8.61"
  },
  "tasks": {
    "check": "deno check src/main.ts tests/main_test.ts tests/model_route_test.ts tests/argv_test.ts tests/host-simulator.ts scripts/package.ts scripts/sync-upstream.ts",
    "lint": "deno lint src scripts tests bundle.config.ts",
    "format": "deno fmt src scripts tests bundle.config.ts deno.json package.json README.md AGENTS.md",
    "test": "deno test --allow-read --allow-env --allow-write tests/main_test.ts tests/model_route_test.ts",
    "test:argv": "deno test --allow-all tests/argv_test.ts",
    "simulate": "deno run --allow-run --allow-read --allow-env --allow-net tests/host-simulator.ts",
    "dev": "deno run --no-prompt --allow-run --allow-read --allow-env --allow-net src/main.ts",
    "build": "deno bundle src/main.ts -o dist/main.js",
    "sync": "deno run --allow-net --allow-read --allow-write --allow-env scripts/sync-upstream.ts",
    "package": "deno run --allow-run --allow-net --allow-read --allow-write --allow-env scripts/package.ts"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.ns", "dom", "esnext"]
  },
  "fmt": {
    "lineWidth": 80,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
